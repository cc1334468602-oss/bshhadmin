# ==========================================================
# bshhadmin 管理后台 —— 环境变量模板
# 用法：cp .env.example .env  然后填入真实值，最后 chmod 600 .env
# 注意：.env 已被 .gitignore 排除，切勿提交到仓库
# ==========================================================

# ---- 服务监听 ----
PORT=9192
# 生产环境填 127.0.0.1（只允许 Nginx 转发）；本地开发可填 0.0.0.0
HOST=127.0.0.1

# ---- 共享配置文件（与前台 bshh 指向同一路径）----
# 本后台在「简道云接口」页面保存配置时写入此文件，前台读取后即时生效
# 部署前需确保目录存在：mkdir -p /var/www/shared
JDY_CONFIG_PATH=/var/www/shared/jdy-config.json

# ---- 简道云凭证（初始值）----
# 也可留空，部署后直接在后台「简道云接口」页面填写并保存
JDY_API_KEY=
JDY_APP_ID=

# ---- 表单 entry_id ----
JDY_ENTRY_CUSTOMER=
JDY_ENTRY_LOAN=
JDY_ENTRY_LOAN_HISTORY=
JDY_ENTRY_CASHFLOW=
JDY_ENTRY_INTENTION=
JDY_ENTRY_FOLLOWUP=
JDY_ENTRY_REPAYMENT=

# ---- MySQL 数据库（全量业务数据落地）----
# 启用数据库：填好 DB_HOST 与 DB_PASS 后，系统自动以 MySQL 为主数据源。
# 必须与前台 bshh 指向同一个数据库实例。
DB_HOST=localhost
DB_PORT=3306
DB_USER=bshh_user
DB_PASS=Bshh@2026
DB_NAME=bshh_db
